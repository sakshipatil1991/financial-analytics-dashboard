# Copy this file to .env and fill in your own values
# Command: cp .env.example .env

# Port the backend server will run on
PORT=5000

# MySQL connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=financial_analytics_dashboard
DB_USER=root
DB_PASSWORD=sakshi@11#A

# Secret key used to sign JWT tokens - use a long random string in real use
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=1d

# Comma separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Demo user created by the seed script
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@1234
